# Copy this file to .env and fill in your own values.
# .env is already git-ignored — your real keys never get committed.

# ---- Server ----
PORT=4000
# Any long random string — used to sign the admin login session cookie.
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Admin login (single admin account) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- MongoDB ----
# Local Mongo:   mongodb://127.0.0.1:27017/wmpsc-attendance
# Atlas cluster: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wmpsc-attendance
MONGODB_URI=mongodb://127.0.0.1:27017/wmpsc-attendance

# ---- Cloudinary ----
# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
